# URL base del backend Strapi (sin barra final)
VITE_STRAPI_URL=http://localhost:1337

# Endpoint del contenido "web develop" (opcional)
# Ejemplos:
# VITE_STRAPI_WEB_DEVELOP_ENDPOINT=/api/web-develop
# VITE_STRAPI_WEB_DEVELOP_ENDPOINT=/api/web-develops

# Listado / detalle de artículos del blog (opcional; por defecto /api/blogs-articles)
# VITE_STRAPI_WEB_DEVELOP_ENDPOINT_BLOG=/api/blogs-articles

# Página preview / listado del blog en Strapi (opcional; por defecto /api/blog)
# VITE_STRAPI_WEB_DEVELOP_ENDPOINT_BLOG_PREVIEW=http://localhost:1337/api/blog
